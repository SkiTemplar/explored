    },
    {
      "id": "lote4-huerto",
      "date": "2026-09-28",
      "sheet": "docs/art/packs/lote4-huerto.png",
      "scope": "Fases de cultivo del huerto de Landing (prioridad 3) con Kenney Nature Kit: platanera, piña y limonero."
    }
  ],
