    },
    {
      "id": "lote2-caza",
      "date": "2026-09-28",
      "sheet": "docs/art/packs/lote2-caza.png",
      "scope": "Lanza, arco y flecha: cierra la prioridad 1 (lanza pendiente del lote 1) con piedra y fibra en vez de acero."
    },
    {
      "id": "lote3-comida",
      "date": "2026-09-28",
      "sheet": "docs/art/packs/lote3-comida.png",
