					"Translation": {
						"Text": "the canoe"
					},
					"Key": "Boat_Canoe"
				},
				{
					"Source": {
						"Text": "la canoa con balancín"
					},
					"Translation": {
						"Text": "the outrigger canoe"
					},
					"Key": "Boat_Outrigger"
				},
				{
					"Source": {
						"Text": "la balsa"
					},
					"Translation": {
						"Text": "the raft"
					},
					"Key": "Boat_Raft"
				},
				{
					"Source": {
						"Text": "Ya está ahí."
					},
					"Translation": {
						"Text": "Already there."
					},
					"Key": "Carry_AlreadyThere"
				},
				{
					"Source": {
						"Text": "No entra en la mochila."
					},
					"Translation": {
						"Text": "It won't fit in the backpack."
					},
					"Key": "Carry_BackpackTooBig"
				},
				{
					"Source": {
						"Text": "Pesa demasiado para la mochila."
					},
					"Translation": {
						"Text": "Too heavy for the backpack."
					},
					"Key": "Carry_BackpackTooHeavy"
				},
				{
					"Source": {
						"Text": "El cinturón no tiene enganches libres."
					},
					"Translation": {
						"Text": "No free loops left on your belt."
					},
					"Key": "Carry_BeltFull"
				},
				{
					"Source": {
						"Text": "El cinturón solo lleva herramientas o recipientes."
					},
					"Translation": {
						"Text": "Your belt only holds tools and containers."
					},
					"Key": "Carry_BeltNotTool"
				},
				{
					"Source": {
						"Text": "No queda sitio."
					},
					"Translation": {
						"Text": "No room left."
					},
					"Key": "Carry_ContainerFull"
				},
				{
					"Source": {
						"Text": "Vacíalo antes."
					},
					"Translation": {
						"Text": "Empty it first."
					},
					"Key": "Carry_ContainerNotEmpty"
				},
				{
					"Source": {
						"Text": "No se puede."
					},
					"Translation": {
						"Text": "Can't do that."
					},
					"Key": "Carry_Generic"
				},
				{
					"Source": {
						"Text": "No llevas nada en esa mano."
					},
					"Translation": {
						"Text": "That hand is empty."
					},
					"Key": "Carry_HandEmpty"
				},
				{
					"Source": {
						"Text": "Esa mano ya está ocupada."
					},
					"Translation": {
						"Text": "That hand is already full."
					},
					"Key": "Carry_HandOccupied"
				},
				{
					"Source": {
						"Text": "Tienes las dos manos ocupadas."
					},
					"Translation": {
						"Text": "Both your hands are full."
					},
					"Key": "Carry_HandsFull"
				},
				{
					"Source": {
						"Text": "Ese objeto no se puede coger."
					},
					"Translation": {
						"Text": "You can't pick that up."
					},
					"Key": "Carry_InvalidItem"
				},
				{
					"Source": {
						"Text": "Ahí no hay nada."
					},
					"Translation": {
						"Text": "Nothing there."
					},
					"Key": "Carry_InvalidSlotIndex"
				},
				{
					"Source": {
						"Text": "Necesitas las dos manos libres para esto."
					},
					"Translation": {
						"Text": "You need both hands free for this."
					},
					"Key": "Carry_NeedBothHands"
				},
				{
					"Source": {
						"Text": "No tienes mochila."
					},
					"Translation": {
						"Text": "You have no backpack."
					},
					"Key": "Carry_NoBackpack"
				},
				{
					"Source": {
						"Text": "No tienes dónde guardarlo seco."
					},
					"Translation": {
						"Text": "You have nowhere to keep it dry."
					},
					"Key": "Carry_NoPouch"
				},
				{
					"Source": {
						"Text": "No entra."
					},
					"Translation": {
						"Text": "Won't fit."
					},
					"Key": "Carry_NoRoom"
				},
				{
					"Source": {
						"Text": "No llevas angarillas."
					},
					"Translation": {
						"Text": "You have no travois."
					},
					"Key": "Carry_NoSledge"
				},
				{
					"Source": {
						"Text": "Ahí no se lleva agua."
					},
					"Translation": {
						"Text": "That can't hold water."
					},
					"Key": "Carry_NotALiquidContainer"
				},
				{
					"Source": {
						"Text": "Eso no se lleva puesto."
					},
					"Translation": {
						"Text": "You can't wear that."
					},
					"Key": "Carry_NotEquippable"
				},
				{
					"Source": {
						"Text": "Aquí no hay nada que coger."
					},
					"Translation": {
						"Text": "There's nothing here to pick up."
					},
					"Key": "Carry_NothingToPickUp"
				},
				{
					"Source": {
						"Text": "No puedes con más peso."
					},
					"Translation": {
						"Text": "You can't carry more."
					},
					"Key": "Carry_OverCarryLimit"
				},
				{
					"Source": {
						"Text": "Solo los objetos pequeños caben en los bolsillos."
					},
					"Translation": {
						"Text": "Only small things fit in your pockets."
					},
					"Key": "Carry_PocketTooSmall"
				},
				{
					"Source": {
						"Text": "Los bolsillos están llenos."
					},
					"Translation": {
						"Text": "Your pockets are full."
					},
					"Key": "Carry_PocketsFull"
				},
				{
					"Source": {
						"Text": "Es un solo objeto: no se combina consigo mismo."
					},
					"Translation": {
						"Text": "It's a single object: it can't combine with itself."
					},
					"Key": "Carry_SameItem"
				},
				{
					"Source": {
						"Text": "Ya arrastras unas angarillas."
					},
					"Translation": {
						"Text": "You're already dragging a travois."
					},
					"Key": "Carry_SledgeAttached"
				},
				{
					"Source": {
						"Text": "Las angarillas son para madera y piedra."
					},
					"Translation": {
						"Text": "The travois is for wood and stone."
					},
					"Key": "Carry_SledgeOnlyMaterial"
				},
				{
					"Source": {
						"Text": "Es demasiado grande para guardarlo ahí."
					},
					"Translation": {
						"Text": "It's too big to store there."
					},
					"Key": "Carry_TooBig"
				},
				{
					"Source": {
						"Text": "Pesa demasiado."
					},
					"Translation": {
						"Text": "It's too heavy."
					},
					"Key": "Carry_TooHeavy"
				},
				{
					"Source": {
						"Text": "Eso ocupa las dos manos: no se guarda."
					},
