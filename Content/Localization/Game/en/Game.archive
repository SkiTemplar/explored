		{
			"Namespace": "ExploredBeacon",
			"Children": [
				{
					"Source": {
						"Text": "Esta noche el mar ha dejado leña en la Cala Varada."
					},
					"Translation": {
						"Text": "Last night the sea left firewood in Cala Varada."
					},
					"Key": "Driftwood"
				},
				{
					"Source": {
						"Text": "Poner la lente"
					},
					"Translation": {
						"Text": "Set the lens"
					},
					"Key": "LampLens"
				},
				{
					"Source": {
						"Text": "Encender la baliza"
					},
					"Translation": {
						"Text": "Light the beacon"
					},
					"Key": "LampLight"
				},
				{
					"Source": {
						"Text": "La baliza está encendida"
					},
					"Translation": {
						"Text": "The beacon is lit"
					},
					"Key": "LampLit"
				},
				{
					"Source": {
						"Text": "Verter los tarros"
					},
					"Translation": {
						"Text": "Pour the jars"
					},
					"Key": "LampOil"
				},
				{
					"Source": {
						"Text": "Apretar la mecha"
					},
					"Translation": {
						"Text": "Tighten the wick"
					},
					"Key": "LampWick"
				},
				{
					"Source": {
						"Text": "Falta la lente: está en el «Sáhara»"
					},
					"Translation": {
						"Text": "The lens is missing: it's on the «Sáhara»"
					},
					"Key": "MissingLens"
				},
				{
					"Source": {
						"Text": "Hacen falta dos tarros de aceite"
					},
					"Translation": {
						"Text": "Two jars of oil are needed"
					},
					"Key": "MissingOil"
				},
				{
					"Source": {
						"Text": "Falta la mecha"
					},
					"Translation": {
						"Text": "Wick missing"
					},
					"Key": "MissingWick"
				},
				{
					"Source": {
						"Text": "Leer la página"
					},
					"Translation": {
						"Text": "Read the page"
					},
					"Key": "PageRead"
				},
				{
					"Source": {
						"Text": "Releer la página"
					},
					"Translation": {
						"Text": "Read the page again"
					},
					"Key": "PageReread"
				},
				{
					"Source": {
						"Text": "Cuaderno de guardia · página {0} de {1}"
					},
					"Translation": {
						"Text": "Watch log · page {0} of {1}"
					},
					"Key": "PageTitle"
				},
				{
					"Source": {
						"Text": "Bajar del faro"
					},
					"Translation": {
						"Text": "Climb down"
					},
					"Key": "TowerDown"
				},
				{
					"Source": {
						"Text": "Subir a la linterna"
					},
					"Translation": {
						"Text": "Climb to the lantern"
					},
					"Key": "TowerUp"
				}
			]
		},
		{
			"Namespace": "ExploredBody",
			"Children": [
				{
					"Source": {
						"Text": "Despiertas en el refugio…"
					},
					"Translation": {
						"Text": "You wake up in the shelter…"
					},
					"Key": "FaintShelter"
				},
				{
					"Source": {
						"Text": "Despiertas en Playa Norte…"
					},
					"Translation": {
						"Text": "You wake up on North Beach…"
					},
					"Key": "FaintShore"
				},
				{
					"Source": {
						"Text": "Solo puedo dormir bajo techo."
					},
					"Translation": {
						"Text": "I can only sleep under a roof."
					},
					"Key": "SleepNoRoof"
				},
				{
					"Source": {
						"Text": "Con este temporal no hay quien duerma."
					},
					"Translation": {
						"Text": "Nobody could sleep through this storm."
					},
					"Key": "SleepStorm"
				},
				{
					"Source": {
						"Text": "Tienes demasiada sed para dormir."
					},
					"Translation": {
						"Text": "You're too thirsty to sleep."
					},
					"Key": "SleepThirsty"
				},
				{
					"Source": {
						"Text": "Aún no es hora de dormir."
					},
					"Translation": {
						"Text": "It's not time to sleep yet."
					},
					"Key": "SleepWrongHour"
				},
				{
					"Source": {
						"Text": "Estoy agotada."
					},
					"Translation": {
						"Text": "I'm exhausted."
					},
					"Key": "WarnEnergy"
				},
				{
					"Source": {
						"Text": "Tengo hambre."
					},
					"Translation": {
						"Text": "I'm hungry."
					},
					"Key": "WarnHunger"
				},
				{
					"Source": {
						"Text": "Tengo sed."
					},
					"Translation": {
						"Text": "I'm thirsty."
					},
					"Key": "WarnThirst"
				},
				{
					"Source": {
						"Text": "Tengo frío."
					},
					"Translation": {
						"Text": "I'm cold."
					},
					"Key": "WarnWarmth"
				}
			]
		},
