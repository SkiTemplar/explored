						"Text": "Tienes las dos manos ocupadas."
					},
					"Translation": {
						"Text": "Tienes las dos manos ocupadas."
					},
					"Key": "Carry_HandsFull"
				},
				{
					"Source": {
						"Text": "Ese objeto no se puede coger."
					},
					"Translation": {
						"Text": "Ese objeto no se puede coger."
					},
					"Key": "Carry_InvalidItem"
				},
				{
