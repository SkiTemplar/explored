					},
					"Translation": {
						"Text": "Pesa demasiado para la mochila."
					},
					"Key": "Carry_BackpackTooHeavy"
				},
				{
					"Source": {
						"Text": "El cinturón no tiene enganches libres."
					},
					"Translation": {
						"Text": "El cinturón no tiene enganches libres."
					},
